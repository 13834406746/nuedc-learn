---
import BaseLayout from '../layouts/BaseLayout.astro';
const pf = import.meta.env.BASE_URL;
---
<BaseLayout title="搜索">
  <main class="main-page">
    <h1 style={`margin-bottom:0.3rem;`}>搜索</h1>
    <p style={`color:var(--muted);margin-bottom:1.6rem;`}>输入关键词检索全站内容，支持中文。</p>
    <div id="search"></div>
  </main>
  <link rel="stylesheet" href={`${pf}pagefind/pagefind-ui.css`} />
  <script is:inline src={`${pf}pagefind/pagefind-ui.js`}></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      new PagefindUI({ element: '#search', showSubResults: true });
    });
  </script>
</BaseLayout>
