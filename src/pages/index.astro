---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;

const all = {
  basics: await getCollection('basics'),
  algorithms: await getCollection('algorithms'),
  hardware: await getCollection('hardware'),
  contests: await getCollection('contests'),
};
const total = all.basics.length + all.algorithms.length + all.hardware.length + all.contests.length;
const controlCount = all.algorithms.filter((e) => e.data.track !== 'vision').length;
const visionCount = all.algorithms.filter((e) => e.data.track !== 'control').length;

const sections = [
  { id: 'basics', icon: '📚', name: '基础知识', desc: 'STM32 外设、传感器原理、Python 与 OpenCV 入门——巩固地基' },
  { id: 'algorithms', icon: '⚙️', name: '代码与算法', desc: 'PID、电机闭环、滤波、循迹、视觉识别与通信——本站核心' },
  { id: 'hardware', icon: '🔧', name: '机械与硬件', desc: '车体、云台、安装与选型常识' },
  { id: 'contests', icon: '🏆', name: '赛题解析', desc: '历年真题复盘，串起站内所有技术点' },
];
---
<BaseLayout title="首页">
  <main class="main-page">
    <div class="hero">
      <div class="hero-main">
        <span class="hero-eyebrow">NUEDC · 备战知识库</span>
        <h1>电赛学习站</h1>
        <p class="sub">
          个人备战知识库：控制类走<strong>进阶路线</strong>（串级 PID、调参方法论、姿态解算），视觉类走<strong>从零到实战路线</strong>（环境搭建 → 识别 → 与单片机联动）。所有内容以「跟着做能把题做出来」为标准。
        </p>
        <div class="hero-ctas">
          <a class="hero-cta" href={`${base}path`}>开始学习 →</a>
          <a class="hero-cta-ghost" href={`${base}algorithms`}>浏览算法板块</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><span class="num">{total}</span><span class="label">文章总数</span></div>
          <div class="hero-stat"><span class="num">{controlCount}</span><span class="label">控制类算法</span></div>
          <div class="hero-stat"><span class="num">{visionCount}</span><span class="label">视觉类算法</span></div>
          <div class="hero-stat"><span class="num">{all.contests.length}</span><span class="label">赛题解析</span></div>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 360 300" fill="none">
          <g stroke="url(#hero-line)" stroke-width="1.6" stroke-linecap="round">
            <path d="M40 240h70l24-24h86"/>
            <path d="M60 268h56l20-20"/>
            <path d="M40 60h64l28 28h108"/>
            <path d="M120 36v40"/>
            <path d="M250 88v52"/>
            <path d="M250 216v-48h52"/>
            <path d="M88 152h64l20 20h48"/>
          </g>
          <g fill="url(#hero-dot)">
            <circle cx="40" cy="240" r="4.5"/><circle cx="220" cy="216" r="4.5"/>
            <circle cx="60" cy="268" r="4.5"/><circle cx="136" cy="248" r="4.5"/>
            <circle cx="40" cy="60" r="4.5"/><circle cx="240" cy="88" r="4.5"/>
            <circle cx="120" cy="36" r="4.5"/><circle cx="250" cy="140" r="4.5"/>
            <circle cx="302" cy="168" r="4.5"/><circle cx="88" cy="152" r="4.5"/><circle cx="220" cy="172" r="4.5"/>
          </g>
          <rect x="150" y="110" width="72" height="72" rx="12" stroke="url(#hero-line)" stroke-width="2"/>
          <rect x="168" y="128" width="36" height="36" rx="7" fill="url(#hero-dot)" opacity="0.9"/>
          <defs>
            <linearGradient id="hero-line" x1="0" y1="0" x2="360" y2="300">
              <stop stop-color="#2563eb"/><stop offset="1" stop-color="#06b6d4"/>
            </linearGradient>
            <linearGradient id="hero-dot" x1="0" y1="0" x2="360" y2="300">
              <stop stop-color="#3b82f6"/><stop offset="1" stop-color="#22d3ee"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
    </div>

    <div class="section-cards">
      {sections.map((s) => (
        <a class={`section-card sc-${s.id}`} href={`${base}${s.id}`}>
          <span class="card-top">
            <span class="icon">{s.icon}</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </span>
          <span class="name">{s.name}</span>
          <span class="count">（{all[s.id].length} 篇）</span>
          <p class="desc">{s.desc}</p>
        </a>
      ))}
    </div>

    <h2 style={`margin-top:2.4rem;`}>两条学习主线</h2>
    <div class="track-cards">
      <div class="track-card">
        <h3>🎯 控制进阶 <a class="track-more" href={`${base}path`}>完整路径 →</a></h3>
        <ul>
          <li><a href={`${base}docs/algorithms/control/pid-position`}>位置式 PID</a> 打底</li>
          <li>依次过 <a href={`${base}docs/algorithms/control/pid-incremental`}>增量式</a> → <a href={`${base}docs/algorithms/control/pid-cascade`}>串级</a> → <a href={`${base}docs/algorithms/control/pid-tuning`}>调参方法论</a></li>
          <li>最后打通 <a href={`${base}docs/algorithms/control/motor-closed-loop`}>电机闭环</a> 实车链路</li>
        </ul>
      </div>
      <div class="track-card">
        <h3>👁️ 视觉从零 <a class="track-more" href={`${base}path`}>完整路径 →</a></h3>
        <ul>
          <li><a href={`${base}docs/algorithms/vision/vision-setup`}>环境搭建</a> 起步（OpenMV 双路线）</li>
          <li>经 <a href={`${base}docs/algorithms/vision/image-basics`}>图像基础</a> → <a href={`${base}docs/algorithms/vision/color-tracking`}>颜色循迹</a></li>
          <li>最后打通 <a href={`${base}docs/algorithms/vision/vision-uart-protocol`}>与单片机通信</a> 联调</li>
        </ul>
      </div>
    </div>
  </main>
</BaseLayout>
