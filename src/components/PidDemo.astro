---
// 交互式 PID 调参演示：拖滑块改 Kp/Ki/Kd，实时看阶跃响应。
---
<div class="demo-box" id="pid-demo">
  <noscript><p>启用 JavaScript 后可在本页交互式调参。</p></noscript>
  <div class="pid-controls">
    <label>Kp <input type="range" id="pid-kp" min="0" max="20" step="0.1" value="2" /><output id="pid-kp-o">2.0</output></label>
    <label>Ki <input type="range" id="pid-ki" min="0" max="30" step="0.1" value="0" /><output id="pid-ki-o">0.0</output></label>
    <label>Kd <input type="range" id="pid-kd" min="0" max="5" step="0.05" value="0" /><output id="pid-kd-o">0.00</output></label>
  </div>
  <canvas id="pid-canvas" width="860" height="320"></canvas>
  <p class="demo-metrics" id="pid-metrics"></p>
</div>

<script>
  import { simulatePid } from '../lib/pid-sim.js';

  const $ = (id) => document.getElementById(id);
  const canvas = $('pid-canvas'), ctx = canvas.getContext('2d');

  function draw() {
    const kp = parseFloat($('pid-kp').value);
    const ki = parseFloat($('pid-ki').value);
    const kd = parseFloat($('pid-kd').value);
    $('pid-kp-o').value = kp.toFixed(1);
    $('pid-ki-o').value = ki.toFixed(1);
    $('pid-kd-o').value = kd.toFixed(2);

    const r = simulatePid({ kp, ki, kd, steps: 400 });
    const W = canvas.width, H = canvas.height;
    const maxV = Math.max(r.setpoint * 1.3, ...r.y) * 1.05;
    const x = (i) => (i / (r.y.length - 1)) * W;
    const yv = (v) => H - (v / maxV) * (H - 20) - 10;

    ctx.clearRect(0, 0, W, H);
    // 网格与目标线
    ctx.strokeStyle = '#eee'; ctx.beginPath();
    for (let g = 0; g <= 5; g++) { ctx.moveTo(0, (g / 5) * H); ctx.lineTo(W, (g / 5) * H); }
    ctx.stroke();
    ctx.strokeStyle = '#0a5a9c'; ctx.setLineDash([6, 4]); ctx.beginPath();
    ctx.moveTo(0, yv(r.setpoint)); ctx.lineTo(W, yv(r.setpoint)); ctx.stroke();
    ctx.setLineDash([]);
    // 响应曲线
    ctx.strokeStyle = '#d33'; ctx.lineWidth = 2; ctx.beginPath();
    r.y.forEach((v, i) => (i ? ctx.lineTo(x(i), yv(v)) : ctx.moveTo(x(i), yv(v))));
    ctx.stroke(); ctx.lineWidth = 1;

    const settle = r.settleTime === Infinity ? '未稳定' : r.settleTime.toFixed(2) + ' s';
    $('pid-metrics').textContent =
      `超调量 ${r.overshoot.toFixed(1)}%  ·  调节时间(±2%) ${settle}  ·  末值 ${r.y[r.y.length - 1].toFixed(1)}（目标 ${r.setpoint}）`;
  }

  ['pid-kp', 'pid-ki', 'pid-kd'].forEach((id) => $(id).addEventListener('input', draw));
  draw();
</script>
