---
import '../styles/global.css';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · 电赛学习站</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={base}>电赛学习站</a>
        <nav>
          <a href={`${base}basics`}>基础知识</a>
          <a href={`${base}algorithms`}>代码与算法</a>
          <a href={`${base}hardware`}>机械与硬件</a>
          <a href={`${base}contests`}>赛题解析</a>
          <a href={`${base}resources`}>资源</a>
          <a href={`${base}search`}>搜索</a>
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>
